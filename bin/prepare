#!/usr/bin/env bash
# Prepares projects of the workspace for instances in dev mode: Composer install,
# package links, npm install and build.
#
# Projects and link directories are paths relative to the workspace (may be nested).
# A package link replaces a Composer package of a project by a relative symlink to
# its checkout in the workspace (computed from both locations), so the checkout is
# tested instead of the locked version. Lock file and composer.json stay
# untouched; Composer removes only the link when it installs another version.
#
# npm ci runs only when node_modules is missing or older than package-lock.json
# (npm writes node_modules/.package-lock.json at the end of every install).
#
# Usage: bin/prepare [--link <vendor/package>=<directory>]... <project>...
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

usage() {
    fail "Usage: bin/prepare [--link <vendor/package>=<directory>]... <project>..."
}

links=()
projects=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --link)
            [[ $# -ge 2 ]] || usage
            links+=("$2")
            shift 2
            ;;
        -*)
            usage
            ;;
        *)
            projects+=("$1")
            shift
            ;;
    esac
done
(( ${#projects[@]} > 0 )) || usage

for link in "${links[@]}"; do
    if [[ ! "${link}" =~ ^[a-z0-9_.-]+/[a-z0-9_.-]+=[^=]+$ ]]; then
        fail "link '${link}' must have the form vendor/package=directory."
    fi
    check_project_path "directory of link ${link%%=*}" "${link#*=}"
done
for project in "${projects[@]}"; do
    check_project_path project "${project}"
done

link_packages() {
    local project="$1" link package directory target relative
    for link in "${links[@]}"; do
        package="${link%%=*}"
        directory="${link#*=}"
        target="${WORKSPACE_DIR}/${project}/vendor/${package}"
        if [[ ! -e "${target}" && ! -L "${target}" ]]; then
            continue
        fi
        relative="$(realpath -m --relative-to="$(dirname "${target}")" "${WORKSPACE_DIR}/${directory}")"
        if [[ -L "${target}" && "$(readlink "${target}")" == "${relative}" ]]; then
            echo "package link: ${project} uses ${package} from ${directory}"
            continue
        fi
        if [[ -L "${target}" ]]; then
            rm "${target}"
        else
            rm -r -- "${target}"
        fi
        ln -s "${relative}" "${target}"
        echo "package link: ${project} uses ${package} from ${directory}"
    done
}

for project in "${projects[@]}"; do
    path="${WORKSPACE_DIR}/${project}"
    if [[ -f "${path}/composer.json" ]]; then
        echo "composer install: ${project}"
        "${WP_TEST_ENV_DIR}/bin/tools" -w "${project}" composer install --no-interaction --no-progress
        link_packages "${project}"
    fi
    # After Composer: a project's build may use files from its vendor directory.
    if [[ -f "${path}/package.json" ]]; then
        [[ -f "${path}/package-lock.json" ]] || fail "${project} has a package.json but no package-lock.json; run npm install in the project once and commit the lock file."
        if [[ ! -f "${path}/node_modules/.package-lock.json" || "${path}/package-lock.json" -nt "${path}/node_modules/.package-lock.json" ]]; then
            echo "npm ci: ${project}"
            "${WP_TEST_ENV_DIR}/bin/tools" -w "${project}" npm ci --no-audit --no-fund
        else
            echo "npm ci: ${project} is up to date"
        fi
        echo "npm run build: ${project}"
        "${WP_TEST_ENV_DIR}/bin/tools" -w "${project}" npm run build --if-present
    fi
done
