#!/usr/bin/env bash
# Runs a command in the tools image (PHP CLI, Composer, Node, Strauss) as the host
# user; the workspace is writable at /workspace, caches persist in a named volume.
#
# -e passes an environment variable (NAME=value, or NAME to take it from the caller).
#
# Usage: bin/tools [-e NAME[=value]]... [-w <directory in the workspace>] <command>...
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

usage="Usage: bin/tools [-e NAME[=value]]... [-w <directory>] <command>..."
workdir=/workspace
environment=()
while [[ "${1-}" == "-e" || "${1-}" == "-w" ]]; do
    [[ $# -ge 2 ]] || fail "$1 needs a value. ${usage}"
    if [[ "$1" == "-e" ]]; then
        environment+=(-e "$2")
    else
        check_project_path directory "$2"
        workdir="/workspace/$2"
    fi
    shift 2
done
[[ $# -gt 0 ]] || fail "no command given. ${usage}"
docker image inspect "${TOOLS_IMAGE}" >/dev/null 2>&1 || fail "image ${TOOLS_IMAGE} not found; run bin/build first."

exec docker run --rm "${DOCKER_TTY}" \
    --user "$(id -u):$(id -g)" \
    -v "${WORKSPACE_DIR}:/workspace" \
    -v "${TOOLS_CACHE_VOLUME}:/cache" \
    -w "${workdir}" \
    "${environment[@]}" \
    "${TOOLS_IMAGE}" "$@"
