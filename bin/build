#!/usr/bin/env bash
# Builds the images (default: wordpress and tools) and, with the wordpress image,
# pulls the service images if missing. With --pull, base and service images are
# updated (latest stable WordPress).
#
# Usage: bin/build [--pull] [wordpress|tools]...
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

pull=()
images=()
for argument in "$@"; do
    case "${argument}" in
        --pull) pull=(--pull) ;;
        wordpress | tools) images+=("${argument}") ;;
        *) fail "unknown argument '${argument}'. Usage: bin/build [--pull] [wordpress|tools]..." ;;
    esac
done
(( ${#images[@]} > 0 )) || images=(wordpress tools)

for image in "${images[@]}"; do
    case "${image}" in
        wordpress) docker build "${pull[@]}" -t "${WORDPRESS_IMAGE}" "${WP_TEST_ENV_DIR}/docker/wordpress" ;;
        tools) docker build "${pull[@]}" -t "${TOOLS_IMAGE}" "${WP_TEST_ENV_DIR}/docker/tools" ;;
    esac
done

# The service images of compose.yaml; pulled here once instead of by parallel bin/up runs.
if [[ " ${images[*]} " == *" wordpress "* ]]; then
    for image in mariadb:lts axllent/mailpit:latest valkey/valkey:9.1-alpine; do
        if (( ${#pull[@]} > 0 )) || ! docker image inspect "${image}" >/dev/null 2>&1; then
            docker pull --quiet "${image}"
        fi
    done
fi
