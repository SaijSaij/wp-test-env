#!/usr/bin/env bash
# Runs WP-CLI as www-data in a test instance.
#
# Usage: bin/wp [-e NAME=value]... <instance> <wp arguments>...
set -euo pipefail
# shellcheck source=lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

environment=(-e PAGER=cat)
while [[ "${1-}" == "-e" ]]; do
    [[ $# -ge 2 ]] || fail "-e needs NAME=value."
    environment+=(-e "$2")
    shift 2
done
[[ $# -ge 1 ]] || fail "Usage: bin/wp [-e NAME=value]... <instance> <wp arguments>..."
instance="$1"
shift
require_instance "${instance}"

exec docker exec "${DOCKER_TTY}" -u www-data "${environment[@]}" "$(instance_container "${instance}")" wp "$@"
